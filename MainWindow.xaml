<Window x:Class="EchoBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EchoBrowser"
        xmlns:models="clr-namespace:EchoBrowser.Models"
        mc:Ignorable="d"
        Icon="app.ico"
        Title="Echo-Browser"
        Height="840" Width="1380"
        MinHeight="540" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI, -apple-system, Roboto, sans-serif"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Row 0: Custom Window Chrome & Tabs (Edge/Brave Style) -->
            <RowDefinition Height="42"/>
            <!-- Row 1: Main Navigation & Omnibox Bar -->
            <RowDefinition Height="46"/>
            <!-- Row 2: Bookmarks Bar (Toggleable) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: Loading Progress Bar (Micro indicator) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 4: Sidebar + Chromium Content Host Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- ROW 0: WINDOW CHROME & TABS STRIP                            -->
        <!-- ============================================================ -->
        <Grid Grid.Row="0" 
              Background="{DynamicResource TabBarBackgroundBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <!-- Echo Logo / Brand Mark -->
                <ColumnDefinition Width="Auto"/>
                <!-- Tab Items Strip -->
                <ColumnDefinition Width="*"/>
                <!-- Window State Controls (Min, Max, Close) -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand Icon / Echo Glyph & Incognito Badge -->
            <Border Grid.Column="0" 
                    Margin="12,0,8,0" 
                    VerticalAlignment="Center"
                    ToolTip="Echo-Browser">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="app.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="ECHO" 
                               FontWeight="Bold" 
                               FontSize="12" 
                               Margin="8,0,0,0" 
                               Foreground="{DynamicResource AccentSilverBrightBrush}" 
                               VerticalAlignment="Center"/>

                    <!-- Stealth Incognito Badge -->
                    <Border x:Name="badgeIncognito" 
                            Visibility="Collapsed" 
                            Margin="8,0,0,0" 
                            Padding="6,2" 
                            Background="#232731" 
                            BorderBrush="#484E5E" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            VerticalAlignment="Center"
                            ToolTip="Du bist im Inkognito-Modus. Daten werden nach Schließen nicht gespeichert.">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Glasses / Mask icon -->
                            <Path Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                  Fill="{DynamicResource AccentSilverBrush}" Width="12" Height="12" Stretch="Uniform"/>
                            <TextBlock Text="Inkognito" FontSize="10.5" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource AccentSilverBrightBrush}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Multi-Tab Strip Area -->
            <Grid Grid.Column="1" Margin="4,0,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <!-- Dynamic Tabs Collection with Drag & Drop Reordering -->
                        <ItemsControl ItemsSource="{Binding Tabs, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:BrowserTab}">
                                    <Border x:Name="tabBorder"
                                            Height="35"
                                            MinWidth="140"
                                            MaxWidth="220"
                                            Margin="0,0,3,0"
                                            CornerRadius="8,8,0,0"
                                            Cursor="Hand"
                                            Background="{DynamicResource TabBackgroundBrush}"
                                            BorderBrush="{DynamicResource TabBorderBrush}"
                                            BorderThickness="1,1,1,0"
                                            WindowChrome.IsHitTestVisibleInChrome="True"
                                            AllowDrop="True"
                                            PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="Tab_PreviewMouseMove"
                                            PreviewMouseLeftButtonUp="Tab_PreviewMouseLeftButtonUp"
                                            DragOver="Tab_DragOver"
                                            Drop="Tab_Drop">
                                        <Grid Margin="10,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Tab Icon or Loading Dot -->
                                            <Grid Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <!-- Idle Globe Icon -->
                                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
                                                      Fill="{DynamicResource AccentSilverDimBrush}"
                                                      Stretch="Uniform"
                                                      Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisConverter}}"/>
                                                <!-- Loading Circle Spinner -->
                                                <Ellipse Width="12" Height="12"
                                                         Stroke="{DynamicResource ShieldActiveBrush}"
                                                         StrokeThickness="2"
                                                         StrokeDashArray="2 1"
                                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>
                                            </Grid>

                                            <!-- Tab Title -->
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding DisplayTitle}" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       FontWeight="Normal"
                                                       VerticalAlignment="Center" 
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- Tab Close Button -->
                                            <Button Grid.Column="2" 
                                                    Style="{DynamicResource SmallRoundButtonStyle}"
                                                    Margin="6,0,0,0"
                                                    Click="BtnCloseTab_Click"
                                                    Tag="{Binding}"
                                                    ToolTip="Tab schließen (Ctrl+W)"
                                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                                <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                                                      Fill="{DynamicResource AccentSilverDimBrush}" 
                                                      Width="9" Height="9" Stretch="Uniform"/>
                                            </Button>

                                            <!-- Active Tab Bottom Accent Indicator -->
                                            <Border x:Name="activeIndicator"
                                                    Grid.ColumnSpan="3"
                                                    Height="2"
                                                    VerticalAlignment="Bottom"
                                                    Background="{DynamicResource TabActiveIndicatorBrush}"
                                                    Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource TabActiveBackgroundBrush}"/>
                                            <Setter TargetName="activeIndicator" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource AccentSilverDimBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add New Tab Button (+) -->
                        <Button x:Name="btnNewTab" 
                                Style="{DynamicResource IconButtonStyle}"
                                Width="30" Height="30"
                                Margin="4,0,0,3"
                                VerticalAlignment="Center"
                                Click="BtnNewTab_Click"
                                ToolTip="Neuer Tab (Ctrl+T)"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" 
                                  Fill="{DynamicResource AccentSilverBrush}" 
                                  Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Window System Caption Controls -->
            <StackPanel Grid.Column="2" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Top" 
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Minimize Button -->
                <Button Style="{DynamicResource ChromeButtonStyle}" 
                        Click="BtnMinimize_Click" 
                        ToolTip="Minimieren">
                    <Path Data="M19 13H5v-2h14v2z" 
                          Fill="{DynamicResource AccentSilverBrush}" 
                          Width="11" Height="11" Stretch="Uniform"/>
                </Button>
                <!-- Maximize / Restore Button -->
                <Button Style="{DynamicResource ChromeButtonStyle}" 
                        Click="BtnMaximize_Click" 
                        ToolTip="Maximieren / Wiederherstellen">
                    <Path x:Name="pathMaximizeIcon"
                          Data="M3 3h18v18H3V3zm16 16V5H5v14h14z" 
                          Fill="{DynamicResource AccentSilverBrush}" 
                          Width="11" Height="11" Stretch="Uniform"/>
                </Button>
                <!-- Close Window Button -->
                <Button Style="{DynamicResource ChromeCloseButtonStyle}" 
                        Click="BtnCloseWindow_Click" 
                        ToolTip="Schließen">
                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                          Fill="{DynamicResource AccentSilverBrush}" 
                          Width="11" Height="11" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================================================ -->
        <!-- ROW 1: MAIN NAVIGATION & OMNIBOX BAR                         -->
        <!-- ============================================================ -->
        <Border Grid.Row="1" 
                x:Name="borderToolbar"
                Background="{DynamicResource ToolbarBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderSubtleBrush}" 
                BorderThickness="0,0,0,1"
                Padding="8,5">
            <Border.ContextMenu>
                <ContextMenu Background="{DynamicResource SurfaceBrush}" 
                             BorderBrush="{DynamicResource BorderBrush}" 
                             Foreground="{DynamicResource TextPrimaryBrush}">
                    <MenuItem Header="Symbolleiste anpassen" SubmenuOpened="MenuToolbarSubmenu_Opened">
                        <MenuItem Header="Favoriten-Seitenleiste" Tag="Sidebar" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                        <MenuItem Header="Zurück" Tag="Back" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                        <MenuItem Header="Vor" Tag="Forward" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                        <MenuItem Header="Neu laden" Tag="Reload" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                        <MenuItem Header="Startseite" Tag="Home" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                        <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                        <MenuItem Header="Suchmaschinen-Auswahl" Tag="SearchEngine" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                        <MenuItem Header="Erweiterungen" Tag="Extensions" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                        <MenuItem Header="Downloads" Tag="Downloads" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                    </MenuItem>
                    <MenuItem Header="Alle Schaltflächen einblenden" Click="MenuShowAllToolbarButtons_Click"/>
                    <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                    <MenuItem Header="Symbolleiste in den Einstellungen anpassen..." Click="MenuOpenToolbarSettings_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <DockPanel LastChildFill="True">
                
                <!-- Left Navigational Controls -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,8,0">
                    <!-- Toggle Sidebar Button -->
                    <Button x:Name="btnToggleSidebar" 
                            Style="{DynamicResource IconButtonStyle}" 
                            Click="BtnToggleSidebar_Click"
                            ToolTip="Favoriten-Seitenleiste ein-/ausblenden">
                        <Button.ContextMenu>
                            <ContextMenu Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                                <MenuItem Header="Schaltfläche ausblenden" Tag="Sidebar" Click="MenuHideToolbarButton_Click"/>
                                <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                <MenuItem Header="Symbolleiste anpassen" SubmenuOpened="MenuToolbarSubmenu_Opened">
                                    <MenuItem Header="Favoriten-Seitenleiste" Tag="Sidebar" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Zurück" Tag="Back" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Vor" Tag="Forward" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Neu laden" Tag="Reload" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Startseite" Tag="Home" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                    <MenuItem Header="Suchmaschinen-Auswahl" Tag="SearchEngine" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Erweiterungen" Tag="Extensions" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Downloads" Tag="Downloads" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                </MenuItem>
                                <MenuItem Header="Alle Schaltflächen einblenden" Click="MenuShowAllToolbarButtons_Click"/>
                                <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                <MenuItem Header="Symbolleiste in den Einstellungen anpassen..." Click="MenuOpenToolbarSettings_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Path Data="M3 3h18v18H3V3zm6 2v14h12V5H9z" 
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- Back Button -->
                    <Button x:Name="btnBack" 
                            Style="{DynamicResource IconButtonStyle}" 
                            Click="BtnBack_Click"
                            IsEnabled="{Binding ActiveTab.CanGoBack, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="Zurück (Alt+Links)">
                        <Button.ContextMenu>
                            <ContextMenu Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                                <MenuItem Header="Schaltfläche ausblenden" Tag="Back" Click="MenuHideToolbarButton_Click"/>
                                <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                <MenuItem Header="Symbolleiste anpassen" SubmenuOpened="MenuToolbarSubmenu_Opened">
                                    <MenuItem Header="Favoriten-Seitenleiste" Tag="Sidebar" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Zurück" Tag="Back" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Vor" Tag="Forward" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Neu laden" Tag="Reload" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Startseite" Tag="Home" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                    <MenuItem Header="Suchmaschinen-Auswahl" Tag="SearchEngine" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Erweiterungen" Tag="Extensions" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Downloads" Tag="Downloads" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                </MenuItem>
                                <MenuItem Header="Alle Schaltflächen einblenden" Click="MenuShowAllToolbarButtons_Click"/>
                                <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                <MenuItem Header="Symbolleiste in den Einstellungen anpassen..." Click="MenuOpenToolbarSettings_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Path Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" 
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    
                    <!-- Forward Button -->
                    <Button x:Name="btnForward" 
                            Style="{DynamicResource IconButtonStyle}" 
                            Click="BtnForward_Click"
                            IsEnabled="{Binding ActiveTab.CanGoForward, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="Vor (Alt+Rechts)">
                        <Button.ContextMenu>
                            <ContextMenu Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                                <MenuItem Header="Schaltfläche ausblenden" Tag="Forward" Click="MenuHideToolbarButton_Click"/>
                                <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                <MenuItem Header="Symbolleiste anpassen" SubmenuOpened="MenuToolbarSubmenu_Opened">
                                    <MenuItem Header="Favoriten-Seitenleiste" Tag="Sidebar" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Zurück" Tag="Back" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Vor" Tag="Forward" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Neu laden" Tag="Reload" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Startseite" Tag="Home" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                    <MenuItem Header="Suchmaschinen-Auswahl" Tag="SearchEngine" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Erweiterungen" Tag="Extensions" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Downloads" Tag="Downloads" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                </MenuItem>
                                <MenuItem Header="Alle Schaltflächen einblenden" Click="MenuShowAllToolbarButtons_Click"/>
                                <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                <MenuItem Header="Symbolleiste in den Einstellungen anpassen..." Click="MenuOpenToolbarSettings_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Path Data="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" 
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- Reload / Stop Button -->
                    <Button x:Name="btnReload" 
                            Style="{DynamicResource IconButtonStyle}" 
                            Click="BtnReload_Click"
                            ToolTip="Neu laden (Ctrl+R / F5)">
                        <Button.ContextMenu>
                            <ContextMenu Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                                <MenuItem Header="Schaltfläche ausblenden" Tag="Reload" Click="MenuHideToolbarButton_Click"/>
                                <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                <MenuItem Header="Symbolleiste anpassen" SubmenuOpened="MenuToolbarSubmenu_Opened">
                                    <MenuItem Header="Favoriten-Seitenleiste" Tag="Sidebar" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Zurück" Tag="Back" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Vor" Tag="Forward" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Neu laden" Tag="Reload" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Startseite" Tag="Home" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                    <MenuItem Header="Suchmaschinen-Auswahl" Tag="SearchEngine" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Erweiterungen" Tag="Extensions" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Downloads" Tag="Downloads" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                </MenuItem>
                                <MenuItem Header="Alle Schaltflächen einblenden" Click="MenuShowAllToolbarButtons_Click"/>
                                <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                <MenuItem Header="Symbolleiste in den Einstellungen anpassen..." Click="MenuOpenToolbarSettings_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid>
                            <!-- Reload Arrow (When Idle) -->
                            <Path x:Name="pathReload"
                                  Data="M17.65 6.35A7.958 7.958 0 0012 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0112 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                  Width="13" Height="13" Stretch="Uniform"/>
                            <!-- Stop X (When Loading) -->
                            <Path x:Name="pathStop"
                                  Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                  Fill="{DynamicResource StatusDangerBrush}" 
                                  Width="12" Height="12" Stretch="Uniform"
                                  Visibility="Collapsed"/>
                        </Grid>
                    </Button>

                    <!-- Home Button (Startpage) -->
                    <Button x:Name="btnHome" 
                            Style="{DynamicResource IconButtonStyle}" 
                            Click="BtnHome_Click"
                            ToolTip="Startseite (Echo New Tab)">
                        <Button.ContextMenu>
                            <ContextMenu Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                                <MenuItem Header="Schaltfläche ausblenden" Tag="Home" Click="MenuHideToolbarButton_Click"/>
                                <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                <MenuItem Header="Symbolleiste anpassen" SubmenuOpened="MenuToolbarSubmenu_Opened">
                                    <MenuItem Header="Favoriten-Seitenleiste" Tag="Sidebar" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Zurück" Tag="Back" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Vor" Tag="Forward" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Neu laden" Tag="Reload" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Startseite" Tag="Home" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                    <MenuItem Header="Suchmaschinen-Auswahl" Tag="SearchEngine" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Erweiterungen" Tag="Extensions" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Downloads" Tag="Downloads" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                </MenuItem>
                                <MenuItem Header="Alle Schaltflächen einblenden" Click="MenuShowAllToolbarButtons_Click"/>
                                <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                <MenuItem Header="Symbolleiste in den Einstellungen anpassen..." Click="MenuOpenToolbarSettings_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Path Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" 
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <!-- Right Toolbar Controls (Search Engine Selector, Add-on, Downloads, Menu) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                    <!-- Global Search Engine Dropdown -->
                    <ComboBox x:Name="cmbSearchEngine" 
                              Style="{DynamicResource SearchEngineComboBoxStyle}" 
                              Width="116"
                              Margin="0,0,6,0"
                              SelectionChanged="CmbSearchEngine_SelectionChanged"
                              ToolTip="Suchmaschine für Adressleiste und Startseite ändern">
                        <ComboBox.ContextMenu>
                            <ContextMenu Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                                <MenuItem Header="Schaltfläche ausblenden" Tag="SearchEngine" Click="MenuHideToolbarButton_Click"/>
                                <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                <MenuItem Header="Symbolleiste anpassen" SubmenuOpened="MenuToolbarSubmenu_Opened">
                                    <MenuItem Header="Favoriten-Seitenleiste" Tag="Sidebar" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Zurück" Tag="Back" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Vor" Tag="Forward" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Neu laden" Tag="Reload" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Startseite" Tag="Home" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                    <MenuItem Header="Suchmaschinen-Auswahl" Tag="SearchEngine" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Erweiterungen" Tag="Extensions" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Downloads" Tag="Downloads" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                </MenuItem>
                                <MenuItem Header="Alle Schaltflächen einblenden" Click="MenuShowAllToolbarButtons_Click"/>
                                <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                <MenuItem Header="Symbolleiste in den Einstellungen anpassen..." Click="MenuOpenToolbarSettings_Click"/>
                            </ContextMenu>
                        </ComboBox.ContextMenu>
                        <ComboBoxItem Tag="duckduckgo" Content="DuckDuckGo"/>
                        <ComboBoxItem Tag="google" Content="Google"/>
                        <ComboBoxItem Tag="bing" Content="Bing"/>
                        <ComboBoxItem Tag="ecosia" Content="Ecosia"/>
                        <ComboBoxItem Tag="brave" Content="Brave Search"/>
                        <ComboBoxItem Tag="startpage" Content="Startpage"/>
                    </ComboBox>

                    <!-- Pinned Extensions Container -->
                    <StackPanel x:Name="pnlPinnedExtensions" Orientation="Horizontal" Margin="0,0,2,0" VerticalAlignment="Center"/>

                    <!-- WebExtensions Button -->
                    <Button x:Name="btnExtensions" 
                            Style="{DynamicResource IconButtonStyle}" 
                            Click="BtnExtensions_Click"
                            ToolTip="Erweiterungen (WebExtensions)">
                        <Button.ContextMenu>
                            <ContextMenu Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                                <MenuItem Header="Schaltfläche ausblenden" Tag="Extensions" Click="MenuHideToolbarButton_Click"/>
                                <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                <MenuItem Header="Symbolleiste anpassen" SubmenuOpened="MenuToolbarSubmenu_Opened">
                                    <MenuItem Header="Favoriten-Seitenleiste" Tag="Sidebar" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Zurück" Tag="Back" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Vor" Tag="Forward" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Neu laden" Tag="Reload" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Startseite" Tag="Home" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                    <MenuItem Header="Suchmaschinen-Auswahl" Tag="SearchEngine" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Erweiterungen" Tag="Extensions" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Downloads" Tag="Downloads" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                </MenuItem>
                                <MenuItem Header="Alle Schaltflächen einblenden" Click="MenuShowAllToolbarButtons_Click"/>
                                <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                <MenuItem Header="Symbolleiste in den Einstellungen anpassen..." Click="MenuOpenToolbarSettings_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Path Data="M20.5 11H19V7c0-1.1-.9-2-2-2h-4V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4c-1.1 0-1.99.9-1.99 2v3.8H3.5c1.49 0 2.7 1.21 2.7 2.7s-1.21 2.7-2.7 2.7H2V20c0 1.1.9 2 2 2h3.8v-1.5c0-1.49 1.21-2.7 2.7-2.7 1.49 0 2.7 1.21 2.7 2.7V22H17c1.1 0 2-.9 2-2v-4h1.5c1.38 0 2.5-1.12 2.5-2.5s-1.12-2.5-2.5-2.5z" 
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- Downloads Button with Progress Badge -->
                    <Button x:Name="btnDownloads" 
                            Style="{DynamicResource IconButtonStyle}" 
                            Click="BtnDownloads_Click"
                            ToolTip="Downloads (Ctrl+J)">
                        <Button.ContextMenu>
                            <ContextMenu Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                                <MenuItem Header="Schaltfläche ausblenden" Tag="Downloads" Click="MenuHideToolbarButton_Click"/>
                                <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                <MenuItem Header="Symbolleiste anpassen" SubmenuOpened="MenuToolbarSubmenu_Opened">
                                    <MenuItem Header="Favoriten-Seitenleiste" Tag="Sidebar" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Zurück" Tag="Back" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Vor" Tag="Forward" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Neu laden" Tag="Reload" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Startseite" Tag="Home" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                    <MenuItem Header="Suchmaschinen-Auswahl" Tag="SearchEngine" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Erweiterungen" Tag="Extensions" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Downloads" Tag="Downloads" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                </MenuItem>
                                <MenuItem Header="Alle Schaltflächen einblenden" Click="MenuShowAllToolbarButtons_Click"/>
                                <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                <MenuItem Header="Symbolleiste in den Einstellungen anpassen..." Click="MenuOpenToolbarSettings_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid>
                            <Path Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" 
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                  Width="14" Height="14" Stretch="Uniform"/>
                            <Ellipse x:Name="downloadBadge"
                                     Width="7" Height="7"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Fill="{DynamicResource ShieldActiveBrush}"
                                     Visibility="Collapsed"/>
                        </Grid>
                    </Button>

                    <!-- Main 3-Dots Menu Button -->
                    <Button x:Name="btnMenu" 
                            Style="{DynamicResource IconButtonStyle}" 
                            Click="BtnMenu_Click"
                            ToolTip="Hauptmenü">
                        <Button.ContextMenu>
                            <ContextMenu Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                                <MenuItem Header="Symbolleiste anpassen" SubmenuOpened="MenuToolbarSubmenu_Opened">
                                    <MenuItem Header="Favoriten-Seitenleiste" Tag="Sidebar" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Zurück" Tag="Back" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Vor" Tag="Forward" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Neu laden" Tag="Reload" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Startseite" Tag="Home" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                    <MenuItem Header="Suchmaschinen-Auswahl" Tag="SearchEngine" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Erweiterungen" Tag="Extensions" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                    <MenuItem Header="Downloads" Tag="Downloads" IsCheckable="True" Click="MenuToolbarButton_Toggle"/>
                                </MenuItem>
                                <MenuItem Header="Alle Schaltflächen einblenden" Click="MenuShowAllToolbarButtons_Click"/>
                                <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                <MenuItem Header="Symbolleiste in den Einstellungen anpassen..." Click="MenuOpenToolbarSettings_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Path Data="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z" 
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <!-- Center: Smart Omnibox (Address & Search Bar) -->
                <Border CornerRadius="18" 
                        Background="{DynamicResource OmniboxBackgroundBrush}" 
                        BorderBrush="{DynamicResource OmniboxBorderBrush}" 
                        BorderThickness="1"
                        Height="34"
                        x:Name="omniboxContainer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Shield / Site Info Button -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Address Input Text -->
                            <ColumnDefinition Width="*"/>
                            <!-- Bookmark Star Button -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Brave-Style Site-Info & Shield Button with Badge Counter -->
                        <Button x:Name="btnShield" 
                                Grid.Column="0"
                                Style="{DynamicResource IconButtonStyle}"
                                Height="28"
                                MinWidth="30"
                                Padding="6,0"
                                Margin="3,0,2,0"
                                Click="BtnShield_Click"
                                ToolTip="Echo Shield: Werbe- &amp; Tracking-Schutz">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Shield / Lock Icon -->
                                <Path x:Name="pathShieldIcon"
                                      Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" 
                                      Fill="{DynamicResource StatusSuccessBrush}" 
                                      Width="13" Height="13" Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                                <!-- Subtle Badge / Counter -->
                                <Border x:Name="borderShieldBadge"
                                        Background="{DynamicResource ShieldActiveBrush}"
                                        CornerRadius="7"
                                        Padding="5,1,5,1"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="txtShieldBadgeCount"
                                               Text="0"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#0D1117"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Address / Search Input TextBox & Placeholder -->
                        <Grid Grid.Column="1">
                            <TextBox x:Name="txtUrl" 
                                     Style="{DynamicResource OmniboxTextBoxStyle}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     KeyDown="TxtUrl_KeyDown"
                                     GotFocus="TxtUrl_GotFocus"
                                     LostFocus="TxtUrl_LostFocus"/>
                            <TextBlock x:Name="txtUrlPlaceholder"
                                       Text="Suchbegriff oder Webadresse eingeben..."
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="13.5"
                                       FontFamily="Segoe UI, Inter, sans-serif"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtUrl}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Omnibox Bookmark Star Button -->
                        <Button x:Name="btnBookmark" 
                                Grid.Column="2"
                                Style="{DynamicResource IconButtonStyle}"
                                Width="30" Height="28"
                                Margin="0,0,3,0"
                                Click="BtnBookmark_Click"
                                ToolTip="Diese Seite als Lesezeichen speichern (Ctrl+D)">
                            <Path x:Name="pathBookmarkStar"
                                  Data="M22 9.24l-7.19-.62L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27 18.18 21l-1.63-7.03L22 9.24zM12 15.4l-3.76 2.27 1-4.28-3.32-2.88 4.38-.38L12 6.1l1.71 4.04 4.38.38-3.32 2.88 1 4.28L12 15.4z" 
                                  Fill="{DynamicResource AccentSilverDimBrush}" 
                                  Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- ROW 2: BOOKMARKS BAR (GROUPS & EMPTY SPACE OPTIONS)          -->
        <!-- ============================================================ -->
        <Border Grid.Row="2" 
                x:Name="borderBookmarksBar"
                Background="{DynamicResource BookmarksBarBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderSubtleBrush}" 
                BorderThickness="0,0,0,1"
                Padding="10,3"
                AllowDrop="True"
                DragOver="BookmarksBar_DragOver"
                Drop="BookmarksBar_Drop"
                Visibility="Visible">
            <Border.ContextMenu>
                <ContextMenu Background="{DynamicResource SurfaceBrush}" 
                             BorderBrush="{DynamicResource BorderBrush}" 
                             Foreground="{DynamicResource TextPrimaryBrush}">
                    <MenuItem Header="Lesezeichen hinzufügen..." Click="MenuAddBookmark_Click"/>
                    <MenuItem Header="Neue Gruppe erstellen..." Click="MenuAddGroup_Click"/>
                    <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                    <MenuItem Header="Lesezeichenleiste ausblenden" Click="MenuToggleBookmarksBar_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Disabled" 
                          Focusable="False"
                          AllowDrop="True"
                          DragOver="BookmarksBar_DragOver"
                          Drop="BookmarksBar_Drop">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            AllowDrop="True"
                            DragOver="BookmarksBar_DragOver"
                            Drop="BookmarksBar_Drop">
                    <ItemsControl x:Name="itemsBookmarksBar" ItemsSource="{Binding Bookmarks, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Bookmark}">
                                <Grid Margin="0,0,6,0">
                                    <!-- 1. Normal Bookmark Chip -->
                                    <Button x:Name="btnNormalBookmark"
                                            Style="{DynamicResource BookmarkChipStyle}"
                                            Click="BookmarkChip_Click"
                                            Tag="{Binding Url}"
                                            ToolTip="{Binding Url}"
                                            AllowDrop="True"
                                            PreviewMouseLeftButtonDown="BookmarkChip_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="BookmarkChip_PreviewMouseMove"
                                            PreviewMouseLeftButtonUp="BookmarkChip_PreviewMouseLeftButtonUp"
                                            DragOver="BookmarkChip_DragOver"
                                            Drop="BookmarkChip_Drop">
                                        <Button.ContextMenu>
                                            <ContextMenu Background="{DynamicResource SurfaceBrush}" 
                                                         BorderBrush="{DynamicResource BorderBrush}" 
                                                         Foreground="{DynamicResource TextPrimaryBrush}">
                                                <MenuItem Header="In neuem Tab öffnen" Click="MenuItemOpenBookmarkNewTab_Click" Tag="{Binding Url}"/>
                                                <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                                <MenuItem Header="Lesezeichen löschen" Click="MenuItemDeleteBookmark_Click" Tag="{Binding}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="16" Height="16" 
                                                    CornerRadius="8" 
                                                    Background="{DynamicResource SurfaceHoverBrush}" 
                                                    Margin="0,0,6,0">
                                                <TextBlock Text="{Binding DisplayInitial}" 
                                                           FontSize="10" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource AccentSilverBrush}" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 2. Bookmark Group Chip (Accepts drops) -->
                                    <Button x:Name="btnGroupChip"
                                            Style="{DynamicResource BookmarkChipStyle}"
                                            Click="GroupChip_Click"
                                            Tag="{Binding}"
                                            ToolTip="Klicken für Gruppeninhalte (Lesezeichen hierhin ziehen zum Hinzufügen)"
                                            AllowDrop="True"
                                            DragOver="GroupChip_DragOver"
                                            DragLeave="GroupChip_DragLeave"
                                            Drop="GroupChip_Drop"
                                            Visibility="Collapsed">
                                        <Button.ContextMenu>
                                            <ContextMenu Background="{DynamicResource SurfaceBrush}" 
                                                         BorderBrush="{DynamicResource BorderBrush}" 
                                                         Foreground="{DynamicResource TextPrimaryBrush}">
                                                <MenuItem Header="Lesezeichen zu dieser Gruppe hinzufügen..." Click="MenuItemAddBookmarkToGroup_Click" Tag="{Binding}"/>
                                                <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                                <MenuItem Header="Gruppe löschen" Click="MenuItemDeleteGroup_Click" Tag="{Binding}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Border x:Name="groupChipBorder"
                                                CornerRadius="12" 
                                                Padding="7,2" 
                                                Background="{DynamicResource SurfaceHoverBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" 
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                                      Fill="{DynamicResource AccentSilverBrush}"
                                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Border Margin="5,0,0,0" Padding="4,0" CornerRadius="7" Background="{DynamicResource TabBackgroundBrush}">
                                                    <TextBlock Text="{Binding ChildCount}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text=" ▾" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                        <Setter TargetName="btnNormalBookmark" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="btnGroupChip" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============================================================ -->
        <!-- ROW 3: LOADING PROGRESS BAR                                  -->
        <!-- ============================================================ -->
        <ProgressBar Grid.Row="3" 
                     x:Name="progressLoading"
                     Height="2.5" 
                     IsIndeterminate="True" 
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource ShieldActiveBrush}"
                     Visibility="Collapsed"/>

        <!-- ============================================================ -->
        <!-- ROW 4: FAVORITEN SIDEBAR + CHROMIUM RENDER CONTAINER         -->
        <!-- ============================================================ -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Vertical Favorites Sidebar -->
                <ColumnDefinition Width="Auto" x:Name="colSidebar"/>
                <!-- Column 1: Chromium Multi-Tab Host -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- FAVORITEN SIDEBAR -->
            <Border Grid.Column="0" 
                    x:Name="borderSidebar"
                    Width="52"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="Visible">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Scrollable list of Favorite Icons with Hover & Click Animation -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SidebarFavorites, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Margin="0,6,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SidebarFavorite}">
                                    <Button Style="{DynamicResource SidebarFavoriteButtonStyle}"
                                            Click="SidebarFavorite_Click"
                                            Tag="{Binding}"
                                            ToolTip="{Binding Title}">
                                        <Button.ContextMenu>
                                            <ContextMenu Background="{DynamicResource SurfaceBrush}" 
                                                         BorderBrush="{DynamicResource BorderBrush}" 
                                                         Foreground="{DynamicResource TextPrimaryBrush}">
                                                <MenuItem Header="In neuem Tab öffnen" Click="MenuSidebarOpenNewTab_Click" Tag="{Binding}"/>
                                                <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                                <MenuItem Header="Favorit löschen" Click="MenuSidebarDelete_Click" Tag="{Binding}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Path Data="{Binding IconPathData}" 
                                              Fill="{Binding IconColor}" 
                                              Width="18" Height="18" 
                                              Stretch="Uniform"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Bottom Actions: Add Favorite (+) -->
                    <StackPanel Grid.Row="1" Margin="0,4,0,8" HorizontalAlignment="Center">
                        <Button x:Name="btnAddSidebarFavorite" 
                                Style="{DynamicResource IconButtonStyle}"
                                Width="36" Height="36"
                                Click="BtnAddSidebarFavorite_Click"
                                ToolTip="Favorit hinzufügen (+)">
                            <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" 
                                  Fill="{DynamicResource AccentSilverBrush}" 
                                  Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chromium Render Container (Multi-Tab Host) -->
            <Grid Grid.Column="1" x:Name="WebViewContainer" Background="{DynamicResource WindowBackgroundBrush}">
                <!-- Splash / Blank State -->
                <Border x:Name="borderSplash"
                        Background="{DynamicResource WindowBackgroundBrush}" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"
                              Fill="{DynamicResource AccentSilverDimBrush}" 
                              Width="48" Height="48" Stretch="Uniform" Opacity="0.5"/>
                        <TextBlock Text="Echo-Browser" 
                                   FontSize="20" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource AccentSilverBrush}" 
                                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Text="Chromium-Engine wird initialisiert..." 
                                   FontSize="13" 
                                   Foreground="{DynamicResource TextMutedBrush}" 
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================ -->
        <!-- MODERN POPUPS / FLYOUTS                                      -->
        <!-- ============================================================ -->

        <!-- 1. BRAVE-STYLE SHIELD / SITE PERMISSIONS POPUP -->
        <Popup x:Name="popupShield" 
               PlacementTarget="{Binding ElementName=btnShield}" 
               Placement="Bottom" 
               StaysOpen="False" 
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Style="{DynamicResource FlyoutCardStyle}" Width="340" Margin="5">
                <StackPanel>
                    <!-- Header with Host & Security Status -->
                    <DockPanel LastChildFill="True" Margin="0,0,0,12">
                        <Border DockPanel.Dock="Left" 
                                Width="36" Height="36" 
                                CornerRadius="18" 
                                Background="{DynamicResource TabBackgroundBrush}" 
                                Margin="0,0,12,0">
                            <Path x:Name="pathShieldPopupIcon"
                                  Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"
                                  Fill="{DynamicResource StatusSuccessBrush}" 
                                  Width="18" Height="18" Stretch="Uniform" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtShieldHost" Text="Echo Startseite" 
                                       FontWeight="Bold" FontSize="14" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="txtShieldStatus" Text="Sichere Verbindung (TLS/HTTPS)" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource StatusSuccessBrush}"/>
                        </StackPanel>
                    </DockPanel>

                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,10"/>

                    <!-- Shield Status Banner Card -->
                    <Border Background="{DynamicResource TabBackgroundBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="txtShieldActiveState" Text="Echo Shield: Aktiviert" 
                                       FontWeight="Bold" FontSize="13" 
                                       Foreground="{DynamicResource StatusSuccessBrush}"/>
                            <TextBlock Text="Werbe- &amp; Tracking-Schutz aktiv" FontSize="11" 
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Primary Protection Toggles -->
                    <CheckBox x:Name="chkTrackingProtection" 
                              Style="{DynamicResource ModernToggleSwitch}" 
                              IsChecked="True" 
                              Margin="0,4"
                              Checked="ShieldOption_Changed"
                              Unchecked="ShieldOption_Changed">
                        <StackPanel>
                            <TextBlock Text="Schutz auf dieser Website" FontWeight="SemiBold"/>
                            <TextBlock Text="Tracker &amp; Anzeigen auf dieser Domain blockieren" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox x:Name="chkGlobalShield" 
                              Style="{DynamicResource ModernToggleSwitch}" 
                              IsChecked="True" 
                              Margin="0,4"
                              Checked="ShieldOption_Changed"
                              Unchecked="ShieldOption_Changed">
                        <StackPanel>
                            <TextBlock Text="Echo Shield global aktiv" FontWeight="SemiBold"/>
                            <TextBlock Text="Netzwerkfilter für alle Tabs aktivieren" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </CheckBox>

                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,10,0,10"/>

                    <!-- Session Statistic Section -->
                    <Border Background="{DynamicResource OmniboxBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                                      Fill="{DynamicResource ShieldActiveBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtTrackersBlocked" 
                                           Text="0 Tracker und Werbeanzeigen blockiert" 
                                           FontWeight="Bold" FontSize="12" 
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </DockPanel>
                            <DockPanel LastChildFill="True" Margin="0,8,0,0">
                                <TextBlock x:Name="txtFilterRuleCount" 
                                           Text="Filterliste bereit" 
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" 
                                           VerticalAlignment="Center"/>
                                <Button x:Name="btnUpdateFilterList" 
                                        DockPanel.Dock="Right" 
                                        Style="{DynamicResource FlyoutSmallButtonStyle}" 
                                        Content="Filter aktualisieren" 
                                        Click="BtnUpdateFilterList_Click"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Additional Permissions -->
                    <TextBlock Text="ERWEITERTE WEBSITEDATEN" 
                               FontSize="10" FontWeight="Bold" 
                               Foreground="{DynamicResource TextMutedBrush}" 
                               Margin="0,4,0,6"/>

                    <CheckBox x:Name="chkJavaScript" 
                              Style="{DynamicResource ModernToggleSwitch}" 
                              IsChecked="True" 
                              Margin="0,4"
                              Checked="ShieldOption_Changed"
                              Unchecked="ShieldOption_Changed">
                        <StackPanel>
                            <TextBlock Text="JavaScript ausführen" FontWeight="SemiBold"/>
                            <TextBlock Text="Skripte für diese Seite erlauben" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox x:Name="chkPopups" 
                              Style="{DynamicResource ModernToggleSwitch}" 
                              IsChecked="True" 
                              Margin="0,4"
                              Checked="ShieldOption_Changed"
                              Unchecked="ShieldOption_Changed">
                        <StackPanel>
                            <TextBlock Text="Popups blockieren" FontWeight="SemiBold"/>
                            <TextBlock Text="Unerwünschte Fenster abfangen" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </CheckBox>

                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,10,0,10"/>

                    <!-- Clear Site Data Action -->
                    <Button Style="{DynamicResource FlyoutActionButtonStyle}" 
                            HorizontalAlignment="Stretch" 
                            Click="BtnClearSiteData_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" 
                                  Fill="{DynamicResource AccentSilverDimBrush}" 
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Cookies &amp; Websitedaten leeren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 2. EXTENSIONS POPUP -->
        <Popup x:Name="popupExtensions" 
               PlacementTarget="{Binding ElementName=btnExtensions}" 
               Placement="Bottom" 
               StaysOpen="False" 
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Style="{DynamicResource FlyoutCardStyle}" Width="380" MaxHeight="500" Margin="5">
                <StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                        <TextBlock Text="Erweiterungen" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" 
                                Style="{DynamicResource FlyoutSmallButtonStyle}" 
                                Content="+ Installieren (.crx)" 
                                Click="BtnInstallExtensionFromFile_Click"
                                ToolTip="Ungepackte Erweiterung oder .crx Datei installieren"/>
                    </DockPanel>
                    <TextBlock Text="Verwalte installierte Chromium- &amp; WebExtensions" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,10,0,10"/>

                    <!-- Empty State -->
                    <TextBlock x:Name="txtEmptyExtensions" 
                               Text="Keine Erweiterungen installiert" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextMutedBrush}" 
                               HorizontalAlignment="Center" 
                               Margin="0,16"/>

                    <!-- Extensions List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                        <ItemsControl x:Name="icExtensionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource TabBackgroundBrush}" 
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8" 
                                            Padding="10,8" 
                                            Margin="0,0,0,6">
                                        <DockPanel LastChildFill="True">
                                            <!-- Right Action Buttons: Pin, Settings, Toggle, Delete -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Pin Button -->
                                                <Button Style="{DynamicResource IconButtonStyle}" 
                                                        Width="26" Height="26" 
                                                        Tag="{Binding}" 
                                                        Margin="0,0,2,0"
                                                        Click="BtnTogglePinExtension_Click"
                                                        ToolTip="In Symbolleiste anheften / lösen">
                                                    <Path Data="M16 12V4H17V2H7V4H8V12L5 15V17H11V22H13V17H19V15L16 12Z" 
                                                          Fill="{DynamicResource AccentSilverBrush}" 
                                                          Width="11" Height="11" Stretch="Uniform"/>
                                                </Button>

                                                <!-- Open Popup GUI Button -->
                                                <Button Style="{DynamicResource IconButtonStyle}" 
                                                        Width="26" Height="26" 
                                                        Tag="{Binding}" 
                                                        Margin="0,0,2,0"
                                                        Click="BtnOpenExtensionPopup_Click"
                                                        ToolTip="Erweiterungs-Menü (Popup) öffnen">
                                                    <Path Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z" 
                                                          Fill="{DynamicResource AccentSilverBrush}" 
                                                          Width="11" Height="11" Stretch="Uniform"/>
                                                </Button>

                                                <!-- Options / Settings Button -->
                                                <Button Style="{DynamicResource IconButtonStyle}" 
                                                        Width="26" Height="26" 
                                                        Tag="{Binding}" 
                                                        Margin="0,0,4,0"
                                                        Click="BtnOpenExtensionSettings_Click"
                                                        ToolTip="Einstellungen der Erweiterung öffnen">
                                                    <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" 
                                                          Fill="{DynamicResource AccentSilverBrush}" 
                                                          Width="12" Height="12" Stretch="Uniform"/>
                                                </Button>

                                                <!-- Enable / Disable Toggle -->
                                                <CheckBox Style="{DynamicResource ModernToggleSwitch}" 
                                                          IsChecked="{Binding IsEnabled, Mode=OneWay}" 
                                                          Tag="{Binding}" 
                                                          Click="ChkExtensionToggle_Click"
                                                          Margin="2,0,4,0"
                                                          ToolTip="Aktivieren / Deaktivieren"/>

                                                <!-- Remove button -->
                                                <Button Style="{DynamicResource IconButtonStyle}" 
                                                        Width="26" Height="26" 
                                                        Tag="{Binding}" 
                                                        Margin="2,0,0,0"
                                                        Click="BtnRemoveExtension_Click"
                                                        ToolTip="Erweiterung entfernen">
                                                    <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" 
                                                          Fill="{DynamicResource StatusDangerBrush}" 
                                                          Width="11" Height="11" Stretch="Uniform"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- Info -->
                                            <DockPanel LastChildFill="True" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Path Data="M20.5 11H19V7c0-1.1-.9-2-2-2h-4V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4c-1.1 0-1.99.9-1.99 2v3.8H3.5c1.49 0 2.7 1.21 2.7 2.7s-1.21 2.7-2.7 2.7H2V20c0 1.1.9 2 2 2h3.8v-1.5c0-1.49 1.21-2.7 2.7-2.7 1.49 0 2.7 1.21 2.7 2.7V22H17c1.1 0 2-.9 2-2v-4h1.5c1.38 0 2.5-1.12 2.5-2.5s-1.12-2.5-2.5-2.5z" 
                                                      Fill="{DynamicResource AccentSilverDimBrush}" 
                                                      Width="13" Height="13" Stretch="Uniform" 
                                                      DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Id}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,8,0,10"/>

                    <!-- Web Store Link -->
                    <Button Style="{DynamicResource FlyoutActionButtonStyle}" 
                            HorizontalAlignment="Stretch" 
                            Click="BtnOpenChromeWebStore_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" 
                                  Fill="{DynamicResource AccentSilverDimBrush}" 
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Chrome Web Store durchsuchen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 3. DOWNLOADS FLYOUT -->
        <Popup x:Name="popupDownloads" 
               PlacementTarget="{Binding ElementName=btnDownloads}" 
               Placement="Bottom" 
               StaysOpen="False" 
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Style="{DynamicResource FlyoutCardStyle}" Width="360" MaxHeight="450" Margin="5">
                <StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,0,0,10">
                        <TextBlock Text="Downloads" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" 
                                Style="{DynamicResource FlyoutSmallButtonStyle}" 
                                Content="Ordner öffnen" 
                                Click="BtnOpenDownloadsFolder_Click"/>
                    </DockPanel>
                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,8"/>

                    <!-- Empty State -->
                    <TextBlock x:Name="txtEmptyDownloads" 
                               Text="Keine aktuellen Downloads vorhanden" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextMutedBrush}" 
                               HorizontalAlignment="Center" 
                               Margin="0,16"/>

                    <!-- Downloads List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                        <ItemsControl ItemsSource="{Binding Downloads, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DownloadItem}">
                                    <Border Background="{DynamicResource TabBackgroundBrush}" 
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7" 
                                            Padding="10,8" 
                                            Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="12" 
                                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                                       TextTrimming="CharacterEllipsis"/>
                                            <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}" 
                                                         Height="4" 
                                                         Margin="0,6" 
                                                         Foreground="{DynamicResource ShieldActiveBrush}" 
                                                         Background="{DynamicResource SurfaceBrush}" 
                                                         BorderThickness="0"/>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="{Binding ProgressText}" 
                                                           FontSize="11" 
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Button DockPanel.Dock="Right" 
                                                        Click="BtnOpenDownloadFile_Click" 
                                                        Tag="{Binding FilePath}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource FlyoutSmallButtonStyle}">
                                                            <Setter Property="Content" Value="Öffnen"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCrx}" Value="True">
                                                                    <Setter Property="Content" Value="Installieren"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 4. MAIN MENU POPUP -->
        <Popup x:Name="popupMenu" 
               PlacementTarget="{Binding ElementName=btnMenu}" 
               Placement="Bottom" 
               StaysOpen="False" 
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Style="{DynamicResource FlyoutCardStyle}" Width="260" Margin="5">
                <StackPanel>
                    <MenuItem Header="Neuer Tab" InputGestureText="Ctrl+T" Click="MenuNewTab_Click" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <MenuItem Header="Neues Fenster" InputGestureText="Ctrl+N" Click="MenuNewWindow_Click" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <MenuItem Header="Neues Inkognito-Fenster" InputGestureText="Ctrl+Shift+N" Click="MenuNewIncognitoWindow_Click" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,4"/>
                    
                    <MenuItem Header="Lesezeichenleiste" InputGestureText="Ctrl+Shift+B" Click="MenuToggleBookmarksBar_Click" Foreground="{DynamicResource TextPrimaryBrush}">
                        <MenuItem.Icon>
                            <CheckBox x:Name="menuChkBookmarksBar" IsChecked="True" VerticalAlignment="Center" Click="MenuToggleBookmarksBar_Click"/>
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="Favoriten-Seitenleiste" Click="BtnToggleSidebar_Click" Foreground="{DynamicResource TextPrimaryBrush}">
                        <MenuItem.Icon>
                            <CheckBox x:Name="menuChkSidebar" IsChecked="True" VerticalAlignment="Center" Click="BtnToggleSidebar_Click"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    
                    <MenuItem Header="Theme anpassen..." Click="MenuOpenThemePicker_Click" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    
                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,4"/>
                    
                    <MenuItem Header="Downloads" InputGestureText="Ctrl+J" Click="BtnDownloads_Click" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <MenuItem Header="Verlauf anzeigen" InputGestureText="Ctrl+H" Click="MenuHistory_Click" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <MenuItem Header="Entwicklertools (F12)" InputGestureText="F12" Click="MenuDevTools_Click" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    
                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,4"/>
                    
                    <MenuItem Header="Einstellungen &amp; Über Echo" InputGestureText="Ctrl+," Click="MenuSettings_Click" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 5. THEME PICKER FLYOUT -->
        <Popup x:Name="popupTheme" 
               PlacementTarget="{Binding ElementName=btnMenu}" 
               Placement="Bottom" 
               StaysOpen="False" 
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Style="{DynamicResource FlyoutCardStyle}" Width="300" Margin="5">
                <StackPanel>
                    <TextBlock Text="Theme &amp; Erscheinungsbild" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Presets:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>

                    <!-- Preset 1: Silver & Anthracite (Default) -->
                    <Button Style="{DynamicResource BookmarkChipStyle}" 
                            HorizontalAlignment="Stretch" Height="30" Margin="0,2"
                            Background="{DynamicResource TabBackgroundBrush}"
                            Click="BtnThemePreset_Click" Tag="SilverAnthracite">
                        <DockPanel LastChildFill="True">
                            <Ellipse Width="12" Height="12" Fill="#C4C7CC" Stroke="#1C1D21" StrokeThickness="1" Margin="0,0,8,0"/>
                            <TextBlock Text="Silber &amp; Anthrazit (Standard)" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DockPanel>
                    </Button>

                    <!-- Preset 2: Midnight OLED -->
                    <Button Style="{DynamicResource BookmarkChipStyle}" 
                            HorizontalAlignment="Stretch" Height="30" Margin="0,2"
                            Background="{DynamicResource TabBackgroundBrush}"
                            Click="BtnThemePreset_Click" Tag="MidnightOled">
                        <DockPanel LastChildFill="True">
                            <Ellipse Width="12" Height="12" Fill="#FFFFFF" Stroke="#000000" StrokeThickness="1" Margin="0,0,8,0"/>
                            <TextBlock Text="Midnight OLED (Tiefschwarz)" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DockPanel>
                    </Button>

                    <!-- Preset 3: Titanium Light -->
                    <Button Style="{DynamicResource BookmarkChipStyle}" 
                            HorizontalAlignment="Stretch" Height="30" Margin="0,2"
                            Background="{DynamicResource TabBackgroundBrush}"
                            Click="BtnThemePreset_Click" Tag="TitaniumLight">
                        <DockPanel LastChildFill="True">
                            <Ellipse Width="12" Height="12" Fill="#ECEFF2" Stroke="#8A8F99" StrokeThickness="1" Margin="0,0,8,0"/>
                            <TextBlock Text="Titanium Light (Hell &amp; Edel)" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DockPanel>
                    </Button>

                    <!-- Preset 4: Cobalt Slate -->
                    <Button Style="{DynamicResource BookmarkChipStyle}" 
                            HorizontalAlignment="Stretch" Height="30" Margin="0,2"
                            Background="{DynamicResource TabBackgroundBrush}"
                            Click="BtnThemePreset_Click" Tag="CobaltSlate">
                        <DockPanel LastChildFill="True">
                            <Ellipse Width="12" Height="12" Fill="#60A5FA" Stroke="#111827" StrokeThickness="1" Margin="0,0,8,0"/>
                            <TextBlock Text="Cobalt Slate (Anthrazit-Blau)" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DockPanel>
                    </Button>

                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,10,0,10"/>

                    <TextBlock Text="Akzentfarbe:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <WrapPanel Margin="0,2">
                        <Button Style="{DynamicResource SmallRoundButtonStyle}" Width="24" Height="24" Margin="3" Background="#C4C7CC" Click="BtnAccentColor_Click" Tag="#C4C7CC" ToolTip="Silber"/>
                        <Button Style="{DynamicResource SmallRoundButtonStyle}" Width="24" Height="24" Margin="3" Background="#38BDF8" Click="BtnAccentColor_Click" Tag="#38BDF8" ToolTip="Eisblau"/>
                        <Button Style="{DynamicResource SmallRoundButtonStyle}" Width="24" Height="24" Margin="3" Background="#34D399" Click="BtnAccentColor_Click" Tag="#34D399" ToolTip="Smaragd"/>
                        <Button Style="{DynamicResource SmallRoundButtonStyle}" Width="24" Height="24" Margin="3" Background="#F59E0B" Click="BtnAccentColor_Click" Tag="#F59E0B" ToolTip="Bernstein"/>
                        <Button Style="{DynamicResource SmallRoundButtonStyle}" Width="24" Height="24" Margin="3" Background="#F43F5E" Click="BtnAccentColor_Click" Tag="#F43F5E" ToolTip="Rubinrot"/>
                        <Button Style="{DynamicResource SmallRoundButtonStyle}" Width="24" Height="24" Margin="3" Background="#A855F7" Click="BtnAccentColor_Click" Tag="#A855F7" ToolTip="Amethyst"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 6. EIGENE FAVORITEN HINZUFÜGEN POPUP -->
        <Popup x:Name="popupAddFavorite" 
               PlacementTarget="{Binding ElementName=btnAddSidebarFavorite}" 
               Placement="Right" 
               StaysOpen="False" 
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Style="{DynamicResource FlyoutCardStyle}" Width="310" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Favorit hinzufügen" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Name / Titel:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtAddFavTitle" Style="{DynamicResource OmniboxTextBoxStyle}" Height="30" Padding="8,2" Margin="0,0,0,10"/>

                    <TextBlock Text="Web-Adresse (URL):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtAddFavUrl" Text="https://" Style="{DynamicResource OmniboxTextBoxStyle}" Height="30" Padding="8,2" Margin="0,0,0,10"/>

                    <TextBlock Text="Icon wählen:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Style="{DynamicResource SmallRoundButtonStyle}" Width="28" Height="28" Margin="3" Click="SelectFavIcon_Click" Tag="google" ToolTip="Google">
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5.46 8.18H12v2.73h3.14c-.28 1.48-1.55 2.59-3.14 2.59-1.89 0-3.42-1.54-3.42-3.42s1.53-3.42 3.42-3.42c.86 0 1.63.32 2.23.85l1.96-1.96C17.06 6.8 14.7 6 12 6 8.69 6 6 8.69 6 12s2.69 6 6 6c3.47 0 5.76-2.44 5.76-5.87 0-.41-.04-.8-.11-1.13h-.19z" Fill="{DynamicResource AccentSilverBrush}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{DynamicResource SmallRoundButtonStyle}" Width="28" Height="28" Margin="3" Click="SelectFavIcon_Click" Tag="youtube" ToolTip="YouTube">
                            <Path Data="M21.58 7.19a2.76 2.76 0 0 0-1.94-1.96C17.93 4.75 12 4.75 12 4.75s-5.93 0-7.64.48a2.76 2.76 0 0 0-1.94 1.96C1.94 8.9 1.94 12 1.94 12s0 3.1.48 4.81a2.76 2.76 0 0 0 1.94 1.96c1.71.48 7.64.48 7.64.48s5.93 0 7.64-.48a2.76 2.76 0 0 0 1.94-1.96c.48-1.71.48-4.81.48-4.81s0-3.1-.48-4.81zM10 15V9l5.2 3L10 15z" Fill="#FF4444" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{DynamicResource SmallRoundButtonStyle}" Width="28" Height="28" Margin="3" Click="SelectFavIcon_Click" Tag="github" ToolTip="GitHub">
                            <Path Data="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{DynamicResource SmallRoundButtonStyle}" Width="28" Height="28" Margin="3" Click="SelectFavIcon_Click" Tag="chatgpt" ToolTip="ChatGPT">
                            <Path Data="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 14.93V17a1 1 0 0 1-2 0v-.07A6 6 0 0 1 7.07 13H7a1 1 0 0 1 0-2h.07A6 6 0 0 1 11 7.07V7a1 1 0 0 1 2 0v.07A6 6 0 0 1 16.93 11H17a1 1 0 0 1 0 2h-.07A6 6 0 0 1 13 16.93z" Fill="#34D399" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{DynamicResource SmallRoundButtonStyle}" Width="28" Height="28" Margin="3" Click="SelectFavIcon_Click" Tag="reddit" ToolTip="Reddit">
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm6.2 11.23c.04.26.06.52.06.77 0 2.46-2.86 4.45-6.26 4.45s-6.26-1.99-6.26-4.45c0-.25.02-.51.06-.77A1.737 1.737 0 0 1 5 11.5c0-.96.78-1.74 1.74-1.74.52 0 .98.23 1.3.6 1.07-.73 2.52-1.2 4.13-1.26l.84-3.95 2.75.59c.1.58.61 1.02 1.22 1.02.69 0 1.25-.56 1.25-1.25S16.67 4.26 15.98 4.26c-.46 0-.86.25-1.07.62l-3.08-.66a.434.434 0 0 0-.51.34l-.94 4.44c-1.65.05-3.13.52-4.22 1.27.32-.38.79-.62 1.32-.62.96 0 1.74.78 1.74 1.74 0 .5-.21.95-.55 1.26z" Fill="#FF6633" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{DynamicResource SmallRoundButtonStyle}" Width="28" Height="28" Margin="3" Click="SelectFavIcon_Click" Tag="wikipedia" ToolTip="Wikipedia">
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 14.5h-2L9.2 9H7V7.5h4.5V9h-1.3l1.3 5.3 1.7-6.8H12V7.5h3.5V9h-1.2l-1.3 7.5z" Fill="{DynamicResource AccentSilverBrush}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{DynamicResource SmallRoundButtonStyle}" Width="28" Height="28" Margin="3" Click="SelectFavIcon_Click" Tag="globe" ToolTip="Globus (Standard)">
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" Fill="{DynamicResource AccentSilverBrush}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </WrapPanel>

                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Left" Style="{DynamicResource BookmarkChipStyle}" Content="Abbrechen" Click="BtnCancelAddFavorite_Click"/>
                        <Button DockPanel.Dock="Right" Style="{DynamicResource BookmarkChipStyle}" Background="{DynamicResource ButtonHoverBackgroundBrush}" Content="Speichern" Click="BtnSaveAddFavorite_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 7. ADD BOOKMARK FLYOUT -->
        <Popup x:Name="popupAddBookmark"
               PlacementTarget="{Binding ElementName=borderBookmarksBar}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Style="{DynamicResource FlyoutCardStyle}" Width="320" Margin="5">
                <StackPanel>
                    <TextBlock Text="Lesezeichen hinzufügen" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                    <TextBlock Text="Name" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtAddBmTitle" Style="{DynamicResource OmniboxTextBoxStyle}" Height="34" Margin="0,0,0,10"/>

                    <TextBlock Text="Adresse (URL)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtAddBmUrl" Style="{DynamicResource OmniboxTextBoxStyle}" Height="34" Margin="0,0,0,10"/>

                    <TextBlock Text="Gruppe / Ordner" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbAddBmGroup" 
                              Height="32" 
                              Margin="0,0,0,16"
                              Background="{DynamicResource SurfaceBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"/>

                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Left" Style="{DynamicResource BookmarkChipStyle}" Content="Abbrechen" Click="BtnCancelAddBm_Click"/>
                        <Button DockPanel.Dock="Right" Style="{DynamicResource BookmarkChipStyle}" Background="{DynamicResource ButtonHoverBackgroundBrush}" Content="Hinzufügen" Click="BtnSaveAddBm_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 8. ADD BOOKMARK GROUP FLYOUT -->
        <Popup x:Name="popupAddGroup"
               PlacementTarget="{Binding ElementName=borderBookmarksBar}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Style="{DynamicResource FlyoutCardStyle}" Width="300" Margin="5">
                <StackPanel>
                    <TextBlock Text="Neue Gruppe erstellen" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                    <TextBlock Text="Gruppenname" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtAddGroupName" Style="{DynamicResource OmniboxTextBoxStyle}" Height="34" Margin="0,0,0,14"/>

                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Left" Style="{DynamicResource BookmarkChipStyle}" Content="Abbrechen" Click="BtnCancelAddGroup_Click"/>
                        <Button DockPanel.Dock="Right" Style="{DynamicResource BookmarkChipStyle}" Background="{DynamicResource ButtonHoverBackgroundBrush}" Content="Gruppe erstellen" Click="BtnSaveAddGroup_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 8b. BOOKMARK GROUP CONTENT FLYOUT (DRAG & DROP SUPPORTED) -->
        <Popup x:Name="popupBookmarkGroup"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Style="{DynamicResource FlyoutCardStyle}" 
                    Width="300" MaxHeight="420" 
                    Margin="6" Padding="14"
                    AllowDrop="True"
                    DragOver="GroupFlyout_DragOver"
                    Drop="GroupFlyout_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Group Title & Counter Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                        <Button DockPanel.Dock="Right" 
                                Style="{DynamicResource IconButtonStyle}" 
                                Width="22" Height="22" 
                                Click="BtnCloseGroupPopup_Click" 
                                ToolTip="Schließen"
                                VerticalAlignment="Center">
                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                                  Fill="{DynamicResource TextMutedBrush}" 
                                  Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                  Fill="{DynamicResource AccentSilverBrush}" 
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock x:Name="txtBookmarkGroupName" Text="Gruppe" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="8" Background="{DynamicResource TabBackgroundBrush}">
                                <TextBlock x:Name="txtBookmarkGroupCount" Text="0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- Group Bookmarks List -->
                    <ScrollViewer Grid.Row="1" MaxHeight="250" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Empty State message if 0 children -->
                            <TextBlock x:Name="txtGroupEmptyState" 
                                       Text="(Keine Lesezeichen in dieser Gruppe)&#x0a;Ziehe Lesezeichen hierher oder auf den Gruppen-Chip."
                                       Foreground="{DynamicResource TextMutedBrush}" 
                                       FontSize="11" 
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"
                                       Margin="4,8"
                                       Visibility="Collapsed"/>

                            <ItemsControl x:Name="itemsGroupBookmarks">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Bookmark}">
                                        <Border x:Name="borderGroupBmItem"
                                                CornerRadius="6"
                                                Padding="7,5"
                                                Margin="0,1"
                                                Background="Transparent"
                                                Cursor="Hand"
                                                ToolTip="Klick: Öffnen | Ziehen: Auf Leiste verschieben | Rechtsklick: Optionen"
                                                AllowDrop="True"
                                                PreviewMouseLeftButtonDown="GroupBookmarkItem_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="GroupBookmarkItem_PreviewMouseMove"
                                                PreviewMouseLeftButtonUp="GroupBookmarkItem_PreviewMouseLeftButtonUp"
                                                MouseDown="GroupBookmarkItem_MouseDown"
                                                DragOver="GroupBookmarkItem_DragOver"
                                                Drop="GroupBookmarkItem_Drop">
                                            <Border.ContextMenu>
                                                <ContextMenu Background="{DynamicResource SurfaceBrush}" 
                                                             BorderBrush="{DynamicResource BorderBrush}" 
                                                             Foreground="{DynamicResource TextPrimaryBrush}">
                                                    <MenuItem Header="In neuem Tab öffnen" Click="MenuGroupBookmarkOpenNewTab_Click" Tag="{Binding}"/>
                                                    <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                                    <MenuItem Header="Aus Gruppe auf Leiste verschieben" Click="MenuGroupBookmarkMoveToBar_Click" Tag="{Binding}"/>
                                                    <MenuItem Header="Aus Gruppe löschen" Click="MenuGroupBookmarkDelete_Click" Tag="{Binding}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Initial circle badge -->
                                                <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9"
                                                        Background="{DynamicResource SurfaceHoverBrush}"
                                                        Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayInitial}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentSilverBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Title & URL -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" FontWeight="Medium"/>
                                                    <TextBlock Text="{Binding Url}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                </StackPanel>

                                                <!-- Drag handle icon (grip dots) -->
                                                <Path Grid.Column="2" 
                                                      Data="M3 5h2V3H3v2zm0 8h2v-2H3v2zm4 8h2v-2H7v2zM3 9h2V7H3v2zm10-6v2h2V3h-2zm-6 4h2V5H7v2zm10 6h2v-2h-2v2zm0 8h2v-2h-2v2zm-4 0h2v-2h-2v2zm0-8h2v-2h-2v2zm-4 4h2v-2H7v2zm8 0h2v-2h-2v2zm-4 4h2v-2h-2v2z"
                                                      Fill="{DynamicResource TextMutedBrush}" 
                                                      Width="10" Height="10" Stretch="Uniform"
                                                      VerticalAlignment="Center" Margin="6,0,2,0" Opacity="0.5"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="borderGroupBmItem" Property="Background" Value="{DynamicResource BookmarkItemHoverBrush}"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer actions: Add Bookmark to group & Delete group -->
                    <Border Grid.Row="2" Margin="0,8,0,0" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Left" Style="{DynamicResource BookmarkChipStyle}" Padding="6,3" Click="BtnAddBookmarkToCurrentGroup_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontWeight="Bold" Margin="0,0,4,0" Foreground="{DynamicResource AccentSilverBrightBrush}"/>
                                    <TextBlock Text="Lesezeichen hinzufügen..." FontSize="11" Foreground="{DynamicResource AccentSilverBrightBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{DynamicResource BookmarkChipStyle}" Padding="6,3" Click="BtnDeleteCurrentGroup_Click">
                                <TextBlock Text="Gruppe löschen" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            </Button>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Popup>

        <!-- 9. BROWSER HISTORY FLYOUT -->
        <Popup x:Name="popupHistory" 
               PlacementTarget="{Binding ElementName=btnMenu}" 
               Placement="Bottom" 
               StaysOpen="False" 
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Style="{DynamicResource FlyoutCardStyle}" Width="400" MaxHeight="520" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <!-- Clock / History Icon -->
                            <Path Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"
                                  Fill="{DynamicResource AccentSilverBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Verlauf" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <!-- Clear History Button -->
                        <Button DockPanel.Dock="Right" 
                                x:Name="btnClearHistory"
                                Style="{DynamicResource BookmarkChipStyle}" 
                                Content="Verlauf leeren" 
                                Foreground="{DynamicResource TextMutedBrush}"
                                Height="24"
                                Padding="6,0"
                                Click="BtnClearHistory_Click"/>
                    </DockPanel>

                    <!-- Search Input & Incognito Notice Row -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <!-- Incognito Warning (only visible in incognito) -->
                        <Border x:Name="bannerIncognitoHistory" 
                                Visibility="Collapsed" 
                                Background="#232733" 
                                BorderBrush="#3E4554" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="8,6" 
                                Margin="0,0,0,8">
                            <TextBlock Text="🕶️ Du bist im Inkognito-Modus: Besuchte Seiten werden nicht aufgezeichnet." 
                                       FontSize="11" 
                                       Foreground="{DynamicResource AccentSilverBrush}" 
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Search Box -->
                        <TextBox x:Name="txtSearchHistory" 
                                 Style="{DynamicResource OmniboxTextBoxStyle}" 
                                 Height="32" 
                                 TextChanged="TxtSearchHistory_TextChanged"/>
                    </StackPanel>

                    <!-- List of History Entries -->
                    <ScrollViewer Grid.Row="2" 
                                  VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="380">
                        <StackPanel>
                            <TextBlock x:Name="txtEmptyHistory" 
                                       Text="Keine Einträge im Verlauf." 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextMutedBrush}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,30,0,30" 
                                       Visibility="Collapsed"/>

                            <ItemsControl x:Name="listHistory" 
                                          ItemsSource="{Binding FilteredHistory, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:HistoryItem}">
                                        <Border CornerRadius="8" 
                                                Padding="6,6" 
                                                Margin="0,0,0,4"
                                                Background="Transparent"
                                                Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Initial / Favicon circle -->
                                                <Border Grid.Column="0" 
                                                        Width="26" Height="26" 
                                                        CornerRadius="13" 
                                                        Background="{DynamicResource SurfaceBrush}" 
                                                        BorderBrush="{DynamicResource BorderBrush}" 
                                                        BorderThickness="1" 
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayInitial}" 
                                                               FontSize="11" 
                                                               FontWeight="Bold" 
                                                               Foreground="{DynamicResource AccentSilverBrush}" 
                                                               HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Title & Meta (Clickable) -->
                                                <StackPanel Grid.Column="1" 
                                                            VerticalAlignment="Center" 
                                                            MouseLeftButtonDown="HistoryItem_Click"
                                                            Tag="{Binding Url}">
                                                    <TextBlock Text="{Binding Title}" 
                                                               FontWeight="SemiBold" 
                                                               FontSize="12.5" 
                                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding DisplayDomain}" 
                                                                   FontSize="11" 
                                                                   Foreground="{DynamicResource AccentSilverBrush}" 
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text=" • " FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                        <TextBlock Text="{Binding DisplayDate}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                        <TextBlock Text=", " FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                        <TextBlock Text="{Binding DisplayTime}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Delete single history entry button -->
                                                <Button Grid.Column="2" 
                                                        Style="{DynamicResource ChromeIconButton}" 
                                                        Width="22" Height="22" 
                                                        VerticalAlignment="Center" 
                                                        ToolTip="Aus Verlauf entfernen"
                                                        Click="BtnDeleteHistoryItem_Click" 
                                                        Tag="{Binding}">
                                                    <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>

    </Grid>
</Window>