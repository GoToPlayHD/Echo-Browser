<Window x:Class="EchoBrowser.Views.ThemedDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, -apple-system, Roboto, sans-serif"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{DynamicResource SurfaceBrush}" 
            BorderBrush="{DynamicResource SurfaceBorderBrush}" 
            BorderThickness="1" 
            CornerRadius="12" 
            Margin="16"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <!-- Title Bar / Header (Draggable) -->
            <DockPanel LastChildFill="True" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,16">
                <!-- Close Button -->
                <Button DockPanel.Dock="Right" 
                        Style="{DynamicResource ChromeCloseButtonStyle}" 
                        Width="26" Height="26" 
                        Click="BtnClose_Click" 
                        ToolTip="Schließen">
                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                          Fill="{DynamicResource AccentSilverBrush}" 
                          Width="10" Height="10" Stretch="Uniform"/>
                </Button>

                <!-- Brand / Icon + Dialog Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path x:Name="pathHeaderIcon"
                          Data="M20.5 11H19V7c0-1.1-.9-2-2-2h-4V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4c-1.1 0-1.99.9-1.99 2v3.8H3.5c1.49 0 2.7 1.21 2.7 2.7s-1.21 2.7-2.7 2.7H2V20c0 1.1.9 2 2 2h3.8v-1.5c0-1.49 1.21-2.7 2.7-2.7 1.49 0 2.7 1.21 2.7 2.7V22H17c1.1 0 2-.9 2-2v-4h1.5c1.38 0 2.5-1.12 2.5-2.5s-1.12-2.5-2.5-2.5z" 
                          Fill="{DynamicResource AccentSilverBrush}" 
                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtDialogTitle" 
                               Text="Echo-Browser" 
                               FontWeight="SemiBold" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextMutedBrush}" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <!-- Main Content Area -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Status / Type Icon -->
                <Border Grid.Column="0" 
                        Width="44" Height="44" 
                        CornerRadius="22" 
                        Background="{DynamicResource TabBackgroundBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        Margin="0,0,16,0" 
                        VerticalAlignment="Top">
                    <Path x:Name="pathStatusIcon" 
                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" 
                          Fill="{DynamicResource ShieldActiveBrush}" 
                          Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Headline and Description -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="txtHeadline" 
                               Text="Erweiterung installieren" 
                               FontWeight="Bold" 
                               FontSize="15" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               TextWrapping="Wrap" 
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="txtMessage" 
                               Text="Möchtest du diese Erweiterung zu Echo-Browser hinzufügen?" 
                               FontSize="12.5" 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               TextWrapping="Wrap" 
                               LineHeight="18"/>
                </StackPanel>
            </Grid>

            <!-- Optional Details / Metadata Box -->
            <Border x:Name="borderDetails" 
                    Background="{DynamicResource TabBackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="12,10" 
                    Margin="0,0,0,18" 
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="txtDetailsLabel" 
                               Text="Berechtigungen &amp; Details:" 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextMutedBrush}" 
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="txtDetailsContent" 
                               Text="" 
                               FontSize="11.5" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Buttons Bar -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Cancel / Secondary Button -->
                <Button x:Name="btnSecondary" 
                        Content="Abbrechen" 
                        Height="32" 
                        MinWidth="85" 
                        Padding="12,0" 
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        Click="BtnSecondary_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource TabBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="7">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Primary Action Button -->
                <Button x:Name="btnPrimary" 
                        Content="Installieren" 
                        Height="32" 
                        MinWidth="95" 
                        Padding="14,0" 
                        Cursor="Hand"
                        Click="BtnPrimary_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource AccentSilverBrush}"/>
                            <Setter Property="Foreground" Value="#16171A"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="{TemplateBinding Background}" 
                                                CornerRadius="7">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSilverBrightBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSilverDimBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
