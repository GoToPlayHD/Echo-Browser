<Window x:Class="EchoBrowser.Views.ExtensionPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Extension Popup"
        Width="420" Height="560"
        MinWidth="320" MinHeight="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI, -apple-system, Roboto, sans-serif"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="PopupHeaderActionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2E39"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#353B49"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Frame & Drop Shadow -->
    <Border Margin="10" 
            Background="#16171B" 
            BorderBrush="#2D3039" 
            BorderThickness="1" 
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.65" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Popup Header Bar (Draggable) -->
            <Border Grid.Row="0" Background="#1D2026" BorderBrush="#2A2D36" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel LastChildFill="True" Margin="10,0,8,0">
                    <!-- Actions on the right -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Options Page Shortcut -->
                        <Button x:Name="btnOpenOptions" 
                                Style="{StaticResource PopupHeaderActionBtn}" 
                                ToolTip="Optionen in Tab öffnen" 
                                Click="BtnOpenOptions_Click">
                            <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" 
                                  Fill="#94A3B8" Width="13" Height="13" Stretch="Uniform"/>
                        </Button>

                        <!-- Reload Popup Button -->
                        <Button x:Name="btnReload" 
                                Style="{StaticResource PopupHeaderActionBtn}" 
                                ToolTip="Popup neu laden" 
                                Click="BtnReload_Click">
                            <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" 
                                  Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>

                        <!-- Close Button -->
                        <Button Style="{StaticResource PopupHeaderActionBtn}" 
                                ToolTip="Schließen" 
                                Click="BtnClose_Click">
                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                                  Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>

                    <!-- Icon & Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="imgExtIcon" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <Path x:Name="pathDefaultIcon" 
                              Data="M20.5 11H19V7c0-1.1-.9-2-2-2h-4V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4c-1.1 0-1.99.9-1.99 2v3.8H3.5c1.49 0 2.7 1.21 2.7 2.7s-1.21 2.7-2.7 2.7H2V20c0 1.1.9 2 2 2h3.8v-1.5c0-1.49 1.21-2.7 2.7-2.7 1.49 0 2.7 1.21 2.7 2.7V22H17c1.1 0 2-.9 2-2v-4h1.5c1.38 0 2.5-1.12 2.5-2.5s-1.12-2.5-2.5-2.5z" 
                              Fill="#CBD5E1" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock x:Name="txtExtTitle" 
                                   Text="Erweiterung" 
                                   FontWeight="SemiBold" 
                                   FontSize="12" 
                                   Foreground="#F1F5F9" 
                                   VerticalAlignment="Center" 
                                   TextTrimming="CharacterEllipsis" 
                                   MaxWidth="240"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Extension Popup Content: Native WebView2 Component -->
            <Border Grid.Row="1" Background="#16171B" CornerRadius="0,0,11,11" ClipToBounds="True">
                <wv2:WebView2 x:Name="webViewPopup" Margin="0"/>
            </Border>
        </Grid>
    </Border>
</Window>
