<UserControl x:Class="EchoBrowser.Views.Popups.OmniboxSuggestionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EchoBrowser.Services"
             xmlns:controls="clr-namespace:EchoBrowser.Views.Controls">
    <Border Style="{DynamicResource FlyoutCardStyle}" Padding="6" Margin="4,2,4,8">
        <!-- Nicht fokussierbar: die Tastatur bleibt in der Adressleiste, Pfeiltasten steuert das Hauptfenster -->
        <ListBox x:Name="list"
                 Focusable="False"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="List_PreviewMouseMove">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="row" Background="Transparent" CornerRadius="7" Padding="10,7" Margin="0,1">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type loc:OmniboxSuggestion}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Symbol: Lupe für Suchen, sonst das Website-Symbol -->
                        <Grid Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path x:Name="iconSearch"
                                  Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                  Fill="{DynamicResource AccentSilverDimBrush}" Stretch="Uniform" Visibility="Collapsed"/>
                            <controls:SiteIcon x:Name="iconSite" Url="{Binding Url}" Fallback="•" IconSize="16"/>
                        </Grid>

                        <!-- Titel – Adresse -->
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13">
                            <Run Text="{Binding Title, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Run x:Name="runSeparator" Text=" – " Foreground="{DynamicResource TextMutedBrush}"/>
                            <Run x:Name="runUrl" Text="{Binding DisplayUrl, Mode=OneWay}" Foreground="{DynamicResource ShieldActiveBrush}"/>
                        </TextBlock>

                        <!-- Hinweis rechts: "Zu Tab wechseln" bzw. Lesezeichen-Stern -->
                        <Border x:Name="chipTab" Grid.Column="2" Visibility="Collapsed" Margin="10,0,0,0"
                                Padding="8,2" CornerRadius="9" Background="{DynamicResource TabBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Omnibox_SwitchToTab}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <Path x:Name="iconBookmark" Grid.Column="2" Visibility="Collapsed" Margin="10,0,2,0"
                              Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
                              Fill="{DynamicResource StatusWarningBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSearch}" Value="True">
                            <Setter TargetName="iconSearch" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="iconSite" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="runSeparator" Property="Text" Value=""/>
                            <Setter TargetName="runUrl" Property="Text" Value=""/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsTab}" Value="True">
                            <Setter TargetName="chipTab" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsBookmark}" Value="True">
                            <Setter TargetName="iconBookmark" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Border>
</UserControl>
