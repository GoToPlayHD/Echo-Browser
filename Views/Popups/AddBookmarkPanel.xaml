<UserControl x:Class="EchoBrowser.Views.Popups.AddBookmarkPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EchoBrowser.Services"
             x:Name="root">
    <Border Style="{DynamicResource FlyoutCardStyle}" Width="320" Margin="5">
        <StackPanel>
            <TextBlock Text="{loc:Loc Bookmark_AddTitle}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

            <TextBlock Text="{loc:Loc Bookmark_Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="txtAddBmTitle" Style="{DynamicResource OmniboxTextBoxStyle}" Height="34" Margin="0,0,0,10"/>

            <TextBlock Text="{loc:Loc Bookmark_Url}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="txtAddBmUrl" Style="{DynamicResource OmniboxTextBoxStyle}" Height="34" Margin="0,0,0,10"/>

            <TextBlock Text="{loc:Loc Bookmark_GroupFolder}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="cmbAddBmGroup" 
                      Height="32" 
                      Margin="0,0,0,16"
                      Background="{DynamicResource SurfaceBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"/>

            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left" Style="{DynamicResource BookmarkChipStyle}" Content="{loc:Loc Dialog_Cancel}" Click="BtnCancelAddBm_Click"/>
                <Button DockPanel.Dock="Right" Style="{DynamicResource BookmarkChipStyle}" Background="{DynamicResource ButtonHoverBackgroundBrush}" Content="{loc:Loc Common_Add}" Click="BtnSaveAddBm_Click"/>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
