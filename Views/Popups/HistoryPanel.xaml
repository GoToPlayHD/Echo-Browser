<UserControl x:Class="EchoBrowser.Views.Popups.HistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EchoBrowser.Services"
             xmlns:models="clr-namespace:EchoBrowser.Models"
             xmlns:controls="clr-namespace:EchoBrowser.Views.Controls"
             x:Name="root">
    <Border Style="{DynamicResource FlyoutCardStyle}" Width="400" MaxHeight="520" Margin="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- Clock / History Icon -->
                    <Path Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"
                          Fill="{DynamicResource AccentSilverBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="{loc:Loc Nav_History}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <!-- Clear History Button -->
                <Button DockPanel.Dock="Right" 
                        x:Name="btnClearHistory"
                        Style="{DynamicResource BookmarkChipStyle}" 
                        Content="{loc:Loc History_Clear}" 
                        Foreground="{DynamicResource TextMutedBrush}"
                        Height="24"
                        Padding="6,0"
                        Click="BtnClearHistory_Click"/>
            </DockPanel>

            <!-- Search Input & Incognito Notice Row -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <!-- Incognito Warning (only visible in incognito) -->
                <Border x:Name="bannerIncognitoHistory" 
                        Visibility="Collapsed" 
                        Background="{DynamicResource SurfaceHoverBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="8,6" 
                        Margin="0,0,0,8">
                    <TextBlock Text="{loc:Loc History_IncognitoNotice}" 
                               FontSize="11" 
                               Foreground="{DynamicResource AccentSilverBrush}" 
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Search Box -->
                <TextBox x:Name="txtSearchHistory" 
                         Style="{DynamicResource OmniboxTextBoxStyle}" 
                         Height="32" 
                         TextChanged="TxtSearchHistory_TextChanged"/>
            </StackPanel>

            <!-- List of History Entries -->
            <ScrollViewer Grid.Row="2" 
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="380">
                <StackPanel>
                    <TextBlock x:Name="txtEmptyHistory" 
                               Text="{loc:Loc History_Empty}" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextMutedBrush}" 
                               HorizontalAlignment="Center" 
                               Margin="0,30,0,30" 
                               Visibility="Collapsed"/>

                    <ItemsControl x:Name="listHistory" 
                                  ItemsSource="{Binding FilteredEntries, ElementName=root}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:HistoryItem}">
                                <Border CornerRadius="8" 
                                        Padding="6,6" 
                                        Margin="0,0,0,4"
                                        Background="Transparent"
                                        Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Website-Symbol (Buchstabe als Ersatz) -->
                                        <controls:SiteIcon Grid.Column="0" Url="{Binding Url}" Fallback="{Binding DisplayInitial}"
                                                           IconSize="20" Margin="3,0,13,0"/>

                                        <!-- Title & Meta (Clickable) -->
                                        <StackPanel Grid.Column="1" 
                                                    VerticalAlignment="Center" 
                                                    MouseLeftButtonDown="HistoryItem_Click"
                                                    Tag="{Binding Url}">
                                            <TextBlock Text="{Binding Title}" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="12.5" 
                                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding DisplayDomain}" 
                                                           FontSize="11" 
                                                           Foreground="{DynamicResource AccentSilverBrush}" 
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text=" • " FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding DisplayDate}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text=", " FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding DisplayTime}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Delete single history entry button -->
                                        <Button Grid.Column="2" 
                                                Style="{DynamicResource IconButtonStyle}" 
                                                Width="22" Height="22" 
                                                VerticalAlignment="Center" 
                                                ToolTip="{loc:Loc History_RemoveEntry}"
                                                Click="BtnDeleteHistoryItem_Click" 
                                                Tag="{Binding}">
                                            <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
