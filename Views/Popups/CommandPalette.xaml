<UserControl x:Class="EchoBrowser.Views.Popups.CommandPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EchoBrowser.Services"
             xmlns:popups="clr-namespace:EchoBrowser.Views.Popups"
             xmlns:controls="clr-namespace:EchoBrowser.Views.Controls">
    <!-- Befehlspalette (Strg+K): Befehle, offene Tabs, Lesezeichen und Verlauf in einer Suche -->
    <Border Style="{DynamicResource FlyoutCardStyle}" Width="640" Padding="8" Margin="8">
        <StackPanel>
            <Grid Margin="4,2,4,6">
                <TextBox x:Name="txtQuery"
                         Style="{DynamicResource OmniboxTextBoxStyle}"
                         Height="40"
                         FontSize="15"
                         Padding="36,0,12,0"
                         AutomationProperties.Name="{loc:Loc Palette_Placeholder}"
                         TextChanged="TxtQuery_TextChanged"
                         PreviewKeyDown="TxtQuery_PreviewKeyDown"/>
                <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                      Fill="{DynamicResource AccentSilverDimBrush}" Width="16" Height="16" Stretch="Uniform"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False"/>
                <TextBlock Text="{loc:Loc Palette_Placeholder}"
                           FontSize="15" Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextMutedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=txtQuery}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <ListBox x:Name="list"
                     Focusable="False"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="420"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                     PreviewMouseMove="List_PreviewMouseMove">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="row" Background="Transparent" CornerRadius="7" Padding="12,8" Margin="0,1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="row" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type popups:PaletteItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path x:Name="iconCommand"
                                      Data="M7 2v11h3v9l7-12h-4l4-8z"
                                      Fill="{DynamicResource AccentSilverDimBrush}" Stretch="Uniform" Margin="2,0" Visibility="Collapsed"/>
                                <Path x:Name="iconSearch"
                                      Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                      Fill="{DynamicResource AccentSilverDimBrush}" Stretch="Uniform" Visibility="Collapsed"/>
                                <controls:SiteIcon x:Name="iconSite" Url="{Binding Url}" Fallback="•" IconSize="16"/>
                            </Grid>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13">
                                <Run Text="{Binding Title, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Run x:Name="runDetail" Text="{Binding InlineDetail, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}"/>
                            </TextBlock>
                            <Border x:Name="chip" Grid.Column="2" Margin="12,0,0,0" Padding="7,2" CornerRadius="6"
                                    Background="{DynamicResource TabBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    VerticalAlignment="Center" Visibility="{Binding ChipVisibility}">
                                <TextBlock Text="{Binding Chip}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Command">
                                <Setter TargetName="iconCommand" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="iconSite" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Search">
                                <Setter TargetName="iconSearch" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="iconSite" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="txtEmpty" Text="{loc:Loc Palette_NoResults}" Visibility="Collapsed"
                       FontSize="12" Margin="16,10" Foreground="{DynamicResource TextMutedBrush}"/>
        </StackPanel>
    </Border>
</UserControl>
