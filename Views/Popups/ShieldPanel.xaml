<UserControl x:Class="EchoBrowser.Views.Popups.ShieldPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EchoBrowser.Services"
             x:Name="root">
    <Border Style="{DynamicResource FlyoutCardStyle}" Width="340" Margin="5">
        <StackPanel>
            <!-- Header with Host & Security Status -->
            <DockPanel LastChildFill="True" Margin="0,0,0,12">
                <Border DockPanel.Dock="Left" 
                        Width="36" Height="36" 
                        CornerRadius="18" 
                        Background="{DynamicResource TabBackgroundBrush}" 
                        Margin="0,0,12,0">
                    <Path x:Name="pathShieldPopupIcon"
                          Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"
                          Fill="{DynamicResource StatusSuccessBrush}" 
                          Width="18" Height="18" Stretch="Uniform" 
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="txtShieldHost" Text="{loc:Loc Shield_StartPageHost}" 
                               FontWeight="Bold" FontSize="14" 
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="txtShieldStatus" Text="{loc:Loc Security_Secure}" 
                               FontSize="11" 
                               Foreground="{DynamicResource StatusSuccessBrush}"/>
                </StackPanel>
            </DockPanel>

            <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,10"/>

            <!-- Shield Status Banner Card -->
            <Border Background="{DynamicResource TabBackgroundBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock x:Name="txtShieldActiveState" Text="{loc:Loc Shield_ActiveStateOn}" 
                               FontWeight="Bold" FontSize="13" 
                               Foreground="{DynamicResource StatusSuccessBrush}"/>
                    <TextBlock Text="{loc:Loc Shield_SubtitleOn}" FontSize="11" 
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Primary Protection Toggles -->
            <CheckBox x:Name="chkTrackingProtection" 
                      Style="{DynamicResource ModernToggleSwitch}" 
                      IsChecked="True" 
                      Margin="0,4"
                      Checked="ShieldOption_Changed"
                      Unchecked="ShieldOption_Changed">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Shield_SiteToggle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Loc Shield_SiteToggleDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </CheckBox>

            <CheckBox x:Name="chkGlobalShield" 
                      Style="{DynamicResource ModernToggleSwitch}" 
                      IsChecked="True" 
                      Margin="0,4"
                      Checked="ShieldOption_Changed"
                      Unchecked="ShieldOption_Changed">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Shield_GlobalToggle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Loc Shield_GlobalToggleDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </CheckBox>

            <Separator Background="{DynamicResource BorderBrush}" Margin="0,10,0,10"/>

            <!-- Session Statistic Section -->
            <Border Background="{DynamicResource OmniboxBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                              Fill="{DynamicResource ShieldActiveBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTrackersBlocked" 
                                   Text="{loc:Loc Shield_TrackersBlockedZero}" 
                                   FontWeight="Bold" FontSize="12" 
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </DockPanel>
                    <DockPanel LastChildFill="True" Margin="0,8,0,0">
                        <TextBlock x:Name="txtFilterRuleCount" 
                                   Text="{loc:Loc Shield_FilterListReady}" 
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" 
                                   VerticalAlignment="Center"/>
                        <Button x:Name="btnUpdateFilterList" 
                                DockPanel.Dock="Right" 
                                Style="{DynamicResource FlyoutSmallButtonStyle}" 
                                Content="{loc:Loc Shield_UpdateFilters}" 
                                Click="BtnUpdateFilterList_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Additional Permissions -->
            <TextBlock Text="{loc:Loc Shield_AdvancedHeader}" 
                       FontSize="10" FontWeight="Bold" 
                       Foreground="{DynamicResource TextMutedBrush}" 
                       Margin="0,4,0,6"/>

            <CheckBox x:Name="chkJavaScript" 
                      Style="{DynamicResource ModernToggleSwitch}" 
                      IsChecked="True" 
                      Margin="0,4"
                      Checked="ShieldOption_Changed"
                      Unchecked="ShieldOption_Changed">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Shield_JavaScript}" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Loc Shield_JavaScriptDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </CheckBox>

            <CheckBox x:Name="chkPopups" 
                      Style="{DynamicResource ModernToggleSwitch}" 
                      IsChecked="True" 
                      Margin="0,4"
                      Checked="ShieldOption_Changed"
                      Unchecked="ShieldOption_Changed">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Shield_Popups}" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Loc Shield_PopupsDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </CheckBox>

            <Separator Background="{DynamicResource BorderBrush}" Margin="0,10,0,10"/>

            <!-- Clear Site Data Action -->
            <Button Style="{DynamicResource FlyoutActionButtonStyle}" 
                    HorizontalAlignment="Stretch" 
                    Click="BtnClearSiteData_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" 
                          Fill="{DynamicResource AccentSilverDimBrush}" 
                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Shield_ClearCookies}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
