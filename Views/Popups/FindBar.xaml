<UserControl x:Class="EchoBrowser.Views.Popups.FindBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EchoBrowser.Services">
    <!-- Eigene Zeile über dem Seiteninhalt (WPF kann nicht über die WebView zeichnen) -->
    <Border Background="{DynamicResource ToolbarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,5">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Grid Width="260">
                <TextBox x:Name="txtFind"
                         Style="{DynamicResource OmniboxTextBoxStyle}"
                         Height="30"
                         Padding="10,0,64,0"
                         TextChanged="TxtFind_TextChanged"
                         PreviewKeyDown="TxtFind_PreviewKeyDown"/>
                <TextBlock Text="{loc:Loc Find_Placeholder}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="13"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=txtFind}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Trefferanzeige "3/12" rechts im Eingabefeld -->
                <TextBlock x:Name="txtResult"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           IsHitTestVisible="False"/>
            </Grid>

            <ToggleButton x:Name="btnMatchCase"
                          Width="30" Height="30"
                          Margin="6,0,0,0"
                          Cursor="Hand"
                          FocusVisualStyle="{StaticResource EchoFocusVisual}"
                          ToolTip="{loc:Loc Find_MatchCase}"
                          AutomationProperties.Name="{loc:Loc Find_MatchCase}"
                          Click="BtnMatchCase_Click">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6">
                            <TextBlock x:Name="t" Text="Aa" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentSilverDimBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}"/>
                                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource AccentSilverBrightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <Button Style="{DynamicResource IconButtonStyle}" Width="30" Height="30" Margin="2,0,0,0"
                    Click="BtnPrevious_Click"
                    ToolTip="{loc:Loc Find_Previous}"
                    AutomationProperties.Name="{loc:Loc Find_Previous}">
                <Path Data="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Width="12" Height="12" Stretch="Uniform"/>
            </Button>
            <Button Style="{DynamicResource IconButtonStyle}" Width="30" Height="30"
                    Click="BtnNext_Click"
                    ToolTip="{loc:Loc Find_Next}"
                    AutomationProperties.Name="{loc:Loc Find_Next}">
                <Path Data="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Width="12" Height="12" Stretch="Uniform"/>
            </Button>
            <Button Style="{DynamicResource IconButtonStyle}" Width="30" Height="30" Margin="2,0,0,0"
                    Click="BtnClose_Click"
                    ToolTip="{loc:Loc Common_Close}"
                    AutomationProperties.Name="{loc:Loc Common_Close}">
                <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Width="10" Height="10" Stretch="Uniform"/>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
