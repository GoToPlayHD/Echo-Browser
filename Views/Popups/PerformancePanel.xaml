<UserControl x:Class="EchoBrowser.Views.Popups.PerformancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EchoBrowser.Services"
             xmlns:models="clr-namespace:EchoBrowser.Models">
    <!-- Leistung: Speicher von Echo und pro Tab, Tab-Schlaf einstellen und auslösen -->
    <Border Style="{DynamicResource FlyoutCardStyle}" Width="360" Padding="16,14" Margin="5">
        <StackPanel>
            <TextBlock Text="{loc:Loc Perf_Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>

            <!-- Gesamt -->
            <TextBlock x:Name="txtTotal" Margin="0,10,0,0" FontSize="26" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Text="–"/>
            <TextBlock x:Name="txtSummary" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}" Text="{loc:Loc Perf_Measuring}"/>

            <Border Height="1" Margin="0,12" Background="{DynamicResource BorderSubtleBrush}"/>

            <!-- Tab-Schlaf -->
            <TextBlock Text="{loc:Loc Perf_SleepAfter}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <WrapPanel x:Name="panelSleepChoices" Margin="-4,6,0,0"/>
            <Button x:Name="btnSleepNow" Style="{DynamicResource FlyoutActionButtonStyle}" Margin="0,10,0,0"
                    HorizontalAlignment="Left" Click="BtnSleepNow_Click"
                    AutomationProperties.Name="{loc:Loc Perf_SleepNow}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M9.37 5.51A7.35 7.35 0 0 0 9.1 7.5c0 4.08 3.32 7.4 7.4 7.4.68 0 1.35-.09 1.99-.27A7.014 7.014 0 0 1 12 19c-3.86 0-7-3.14-7-7 0-2.93 1.81-5.45 4.37-6.49zM12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"
                          Fill="{DynamicResource AccentSilverBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0"/>
                    <TextBlock Text="{loc:Loc Perf_SleepNow}"/>
                </StackPanel>
            </Button>

            <Border Height="1" Margin="0,12" Background="{DynamicResource BorderSubtleBrush}"/>

            <!-- Tabs nach Speicher -->
            <ListBox x:Name="listTabs" MaxHeight="260" Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayTitle}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:BrowserTab}">
                            <Button Click="TabRow_Click" Tag="{Binding}" Cursor="Hand" Padding="6,5" Margin="-6,0"
                                    HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                    AutomationProperties.Name="{Binding DisplayTitle}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="row" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid x:Name="icon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path x:Name="globe" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
                                              Fill="{DynamicResource AccentSilverDimBrush}" Stretch="Uniform"/>
                                        <Image Source="{Binding Favicon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                    <TextBlock x:Name="title" Grid.Column="1" Text="{Binding DisplayTitle}" FontSize="12.5" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Border x:Name="chip" Grid.Column="2" Visibility="Collapsed" Margin="8,0,0,0" Padding="6,1" CornerRadius="6"
                                            Background="{DynamicResource TabBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="chipText" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding MemoryDisplay}" FontSize="12" Margin="10,0,0,0" MinWidth="44"
                                               TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasFavicon}" Value="True">
                                    <Setter TargetName="globe" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDiscarded}" Value="True">
                                    <Setter TargetName="chip" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="chipText" Property="Text" Value="{loc:Loc Perf_NotLoaded}"/>
                                    <Setter TargetName="icon" Property="Opacity" Value="0.5"/>
                                    <Setter TargetName="title" Property="Opacity" Value="0.6"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSleeping}" Value="True">
                                    <Setter TargetName="chip" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="chipText" Property="Text" Value="{loc:Loc Perf_Sleeping}"/>
                                    <Setter TargetName="icon" Property="Opacity" Value="0.5"/>
                                    <Setter TargetName="title" Property="Opacity" Value="0.6"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="txtShared" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</UserControl>
