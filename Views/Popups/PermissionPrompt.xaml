<UserControl x:Class="EchoBrowser.Views.Popups.PermissionPrompt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EchoBrowser.Services">
    <!-- Abfrage wie bei Chrome: "{Website} möchte: deine Kamera verwenden" – Zulassen / Blockieren -->
    <Border Style="{DynamicResource FlyoutCardStyle}" Width="330" Margin="5">
        <StackPanel>
            <DockPanel LastChildFill="True" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right"
                        Style="{DynamicResource IconButtonStyle}"
                        Width="24" Height="24"
                        VerticalAlignment="Top"
                        Click="BtnDismiss_Click"
                        ToolTip="{loc:Loc Common_Close}"
                        AutomationProperties.Name="{loc:Loc Common_Close}">
                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Width="9" Height="9" Stretch="Uniform"/>
                </Button>
                <TextBlock x:Name="txtTitle"
                           FontWeight="SemiBold" FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="2,0,0,16">
                <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource TabBackgroundBrush}" Margin="0,0,10,0">
                    <Path x:Name="pathIcon" Fill="{DynamicResource AccentSilverBrush}" Width="15" Height="15" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="txtRequest" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="250"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnBlock"
                        Style="{DynamicResource FlyoutActionButtonStyle}"
                        Content="{loc:Loc Perm_Block}"
                        MinWidth="96"
                        Margin="0,0,8,0"
                        Click="BtnBlock_Click"/>
                <Button x:Name="btnAllow"
                        Style="{DynamicResource FlyoutActionButtonStyle}"
                        Content="{loc:Loc Perm_Allow}"
                        MinWidth="96"
                        Click="BtnAllow_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
