<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EchoBrowser</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <StartupObject>EchoBrowser.App</StartupObject>
    <Version>1.2.9</Version>
    <!-- Nach außen heißt der Browser nur "Echo" (Task-Manager, Dateieigenschaften, "Öffnen mit").
         EXE-Name, Paket-ID (Velopack) und Datenordner bleiben "EchoBrowser" – sonst fänden bestehende
         Installationen weder Updates noch ihre Daten. -->
    <Product>Echo</Product>
    <AssemblyTitle>Echo</AssemblyTitle>
    <Company>Echo</Company>
  </PropertyGroup>

  <!-- App.xaml als Page deklarieren, damit Main() den VelopackApp-Bootstrap vor WPF ausführen kann -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!-- Testprojekt liegt im Unterordner und wird separat gebaut -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Page Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="app.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <!-- Übersetzungen: Localization/<sprache>.json, werden in die EXE eingebettet -->
    <EmbeddedResource Include="Localization\*.json" />
    <!-- Interne Seiten (echo://start, echo://settings, Absturzseite) – siehe Services/PageTemplates.cs -->
    <EmbeddedResource Include="InternalPages\*.html" LogicalName="InternalPages.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>